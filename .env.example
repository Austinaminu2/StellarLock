# StellarLock Environment Variables
# Do not edit this file directly. Copy the environment-specific template instead:
#
#   cp .env.testnet .env   # local development
#   cp .env.staging .env   # QA / pre-production
#   cp .env.mainnet .env   # production
#
# Required variables:
#   VITE_NETWORK                  testnet | staging | mainnet
#   VITE_RPC_URL                  Soroban RPC endpoint
#   VITE_HORIZON_URL              Horizon REST endpoint
#   VITE_TOKEN_LOCKER_CONTRACT    Token locker contract ID
#   VITE_LP_LOCKER_CONTRACT       LP locker contract ID
#   VITE_CONTRACT_ENV             testnet | mainnet (selects registry.json addresses)
#   VITE_CONTRACT_VERSION         e.g. v1
#
# Optional:
#   VITE_PLAUSIBLE_DOMAIN
#   VITE_PLAUSIBLE_API_HOST
#   VITE_SENTRY_DSN
#   VITE_APP_URL

# -----------------------------------------------------------------------------
# Indexer & notifier (server-side)
# -----------------------------------------------------------------------------
# Read by the long-running indexer/notifier processes (indexer/*.ts) and the
# serverless functions in api/. These are NOT exposed to the browser bundle.
# See README "Indexer & notification worker" and docs/indexer-architecture.md.
#
# Shared (indexer, notifier, api/)
#   LOCK_INDEX_DB_PATH          optional  default: lock-index.sqlite
#                               SQLite index file. Must point to the same file
#                               for every process.
#
# Indexer (pnpm indexer:start)
#   SOROBAN_RPC_URL             optional  default: https://soroban-testnet.stellar.org
#   TOKEN_LOCKER_CONTRACT       required* default: (empty)
#   LP_LOCKER_CONTRACT          required* default: (empty)
#                               * at least one of the two contract IDs must be set
#   INDEXER_POLL_INTERVAL_MS    optional  default: 10000 (10s)
#   INDEXER_RPC_TIMEOUT_MS      optional  default: 15000 (15s) per RPC call
#
# Notifier (pnpm notifier:start)
#   RESEND_API_KEY              required for email  default: (empty — emails are skipped)
#   EMAIL_FROM                  optional  default: StellarLock <notify@stellarlock.xyz>
#   WEBHOOK_SECRET              required for signed webhooks  default: (empty — no
#                               X-StellarLock-Signature header is sent)
#   NOTIFIER_INTERVAL_MS        optional  default: 3600000 (1h)
#   PUBLIC_APP_URL              optional  default: https://app.stellarlock.xyz
#                               Base URL used for links in reminder emails/webhooks
#
# api/ health checks (api/health.ts, api/readiness.ts) also read VITE_NETWORK,
# VITE_RPC_URL and VITE_HORIZON_URL (documented above; default to the testnet
# endpoints, or mainnet ones when VITE_NETWORK=mainnet) and the platform-provided
# NODE_ENV (default: production).
#
#LOCK_INDEX_DB_PATH=lock-index.sqlite
#SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
#TOKEN_LOCKER_CONTRACT=
#LP_LOCKER_CONTRACT=
#INDEXER_POLL_INTERVAL_MS=10000
#INDEXER_RPC_TIMEOUT_MS=15000
#RESEND_API_KEY=
#EMAIL_FROM=StellarLock <notify@stellarlock.xyz>
#WEBHOOK_SECRET=
#NOTIFIER_INTERVAL_MS=3600000
#PUBLIC_APP_URL=https://app.stellarlock.xyz
